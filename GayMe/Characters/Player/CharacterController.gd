extends KinematicBody
# Скрипт работает на узле KinematicBody.
# KinematicBody подходит для персонажа, которым мы управляем через код.


# ============================================================
# НАСТРОЙКИ ПЕРСОНАЖА
# ============================================================

var velocity = Vector3()
# Текущая скорость игрока:
# velocity.x — движение влево/вправо
# velocity.y — движение вверх/вниз, включая прыжок и гравитацию
# velocity.z — движение вперёд/назад


var gravity = -20
# Сила гравитации.
# Отрицательное значение тянет игрока вниз.


var jump_speed = 9
# Скорость прыжка.
# Чем больше значение, тем выше игрок прыгает.


var speed = 4
# Скорость движения игрока по земле.


var is_paused = false
# Находится ли игра на паузе.


var pause_menu = null
# Пока не используется.
# Можно будет использовать позже для ссылки на меню паузы.


var max_hp = 300
# Максимальное здоровье игрока.


var current_hp = 100
# Текущее здоровье игрока.


var is_dead = false
# Умер ли игрок.


# ============================================================
# ЗАПУСК ИГРОКА
# ============================================================

func _ready():
	# Эта функция вызывается один раз,
	# когда игрок появляется в сцене.

	update_hp_ui()
	# Обновляем полоску здоровья при запуске.


# ============================================================
# ДВИЖЕНИЕ ИГРОКА
# ============================================================

func _physics_process(delta):
	if is_paused or is_dead:
		return

	var input_dir = Vector3()

	if Input.is_key_pressed(KEY_W):
		input_dir.z -= 1
	if Input.is_key_pressed(KEY_A):
		input_dir.x -= 1
	if Input.is_key_pressed(KEY_S):
		input_dir.z += 1
	if Input.is_key_pressed(KEY_D):
		input_dir.x += 1

	input_dir = input_dir.normalized()

	var direction = ($CameraPivot.transform.basis * input_dir).normalized()
	direction.y = 0

	velocity.x = direction.x * speed
	velocity.z = direction.z * speed

	if not is_on_floor():
		velocity.y += gravity * delta
	else:
		velocity.y = 0

		if Input.is_action_just_pressed("ui_accept"):
			velocity.y = jump_speed

	velocity = move_and_slide(velocity, Vector3.UP)

	# --------------------------------------------------------
	# ЧТЕНИЕ КЛАВИШ ДВИЖЕНИЯ
	# --------------------------------------------------------

	if Input.is_key_pressed(KEY_W):
		# W — движение вперёд.
		input_dir.z -= 1


	if Input.is_key_pressed(KEY_A):
		# A — движение влево.
		input_dir.x -= 1


	if Input.is_key_pressed(KEY_S):
		# S — движение назад.
		input_dir.z += 1


	if Input.is_key_pressed(KEY_D):
		# D — движение вправо.
		input_dir.x += 1


	input_dir = input_dir.normalized()
	# Нормализуем направление.
	# Это нужно, чтобы движение по диагонали не было быстрее,
	# чем движение только вперёд или только вбок.


	# --------------------------------------------------------
	# ДВИЖЕНИЕ ОТНОСИТЕЛЬНО КАМЕРЫ
	# --------------------------------------------------------

	# Берём направление игрока относительно поворота CameraPivot.
	#
	# Например:
	# если камера повернута вправо, то W будет двигать игрока
	# именно туда, куда смотрит камера.
	#
	# $CameraPivot — путь к узлу CameraPivot внутри игрока.


	direction.y = 0
	# Камера может быть наклонена вверх или вниз.
	# Если не обнулить Y, игрок может начать двигаться в воздух
	# при наклоне камеры.
	#
	# Нам нужно движение только по горизонтальной плоскости XZ.


	direction = direction.normalized()
	# После обнуления Y снова нормализуем направление.


	# --------------------------------------------------------
	# ПРИМЕНЕНИЕ СКОРОСТИ
	# --------------------------------------------------------

	velocity.x = direction.x * speed
	# Задаём горизонтальную скорость по оси X.


	velocity.z = direction.z * speed
	# Задаём горизонтальную скорость по оси Z.


	# --------------------------------------------------------
	# ГРАВИТАЦИЯ
	# --------------------------------------------------------

	if not is_on_floor():
		# Если игрок не стоит на поверхности,
		# применяем гравитацию.

		velocity.y += gravity * delta
		# Постепенно увеличиваем падение игрока.


	else:
		# Если игрок стоит на земле,
		# не даём ему продолжать накапливать скорость вниз.

		velocity.y = 0


		# ----------------------------------------------------
		# ПРЫЖОК
		# ----------------------------------------------------

		if Input.is_action_just_pressed("ui_accept"):
			# ui_accept обычно привязан к Space/Enter.
			# just_pressed срабатывает один раз в момент нажатия.

			velocity.y = jump_speed
			# Запускаем игрока вверх.


	# --------------------------------------------------------
	# ПЕРЕМЕЩЕНИЕ KINEMATICBODY
	# --------------------------------------------------------

	velocity = move_and_slide(velocity, Vector3.UP)
	# Передаём скорость физическому телу.
	#
	# Vector3.UP сообщает Godot, где находится верх.
	# Благодаря этому is_on_floor() может нормально работать.


# ============================================================
# КЛАВИША ESC И ПАУЗА
# ============================================================

func _input(event):
	# Эта функция получает события ввода:
	# клавиатуру, мышь и другие события.


	if event is InputEventKey:
		# Проверяем, что событие связано с клавиатурой.


		if event.scancode == KEY_ESCAPE and event.pressed:
			# Проверяем:
			# 1. нажата именно Escape;
			# 2. клавиша сейчас нажата, а не отпущена.


			if is_paused:
				# Если игра уже на паузе — продолжаем игру.
				resume_game()


			else:
				# Если игра не на паузе — ставим её на паузу.
				pause_game()


# ============================================================
# ЗДОРОВЬЕ И УРОН
# ============================================================

func take_damage(amount):
	# Эта функция вызывается ловушками, врагами и атаками.
	# amount — количество получаемого урона.


	if is_dead:
		# Мёртвый игрок не может получить дополнительный урон.
		return


	current_hp -= amount
	# Вычитаем урон из текущего здоровья.


	current_hp = max(current_hp, 0)
	# Не позволяем здоровью стать меньше нуля.


	update_hp_ui()
	# Обновляем полоску здоровья.


	if current_hp <= 0:
		# Если здоровье закончилось — умираем.
		die()


func heal(amount):
	# Восстанавливает игроку здоровье.


	if is_dead:
		# Мёртвого игрока не лечим.
		return


	current_hp += amount
	# Добавляем здоровье.


	current_hp = min(current_hp, max_hp)
	# Не позволяем здоровью быть больше максимального.


	update_hp_ui()
	# Обновляем полоску здоровья.


# ============================================================
# СМЕРТЬ И ПЕРЕЗАПУСК
# ============================================================

func die():
	# Вызывается, когда здоровье игрока достигает нуля.


	is_dead = true
	# Блокируем движение и другие действия игрока.


	print("Игрок умер!")
	# Выводим сообщение в Output Godot.


	var timer = Timer.new()
	# Создаём таймер через код.


	timer.wait_time = 1.0
	# Ждём одну секунду.


	timer.one_shot = true
	# Таймер сработает только один раз.


	add_child(timer)
	# Добавляем таймер внутрь игрока.


	timer.connect("timeout", self, "restart_scene")
	# Когда таймер закончится,
	# вызовется функция restart_scene().


	timer.start()
	# Запускаем таймер.


func restart_scene():
	# Перезапускает текущую сцену.


	get_tree().reload_current_scene()


# ============================================================
# ОБНОВЛЕНИЕ HP-БАРА
# ============================================================

func update_hp_ui():
	# Ищем интерфейс и обновляем его HPBar.


	var ui = get_parent().get_node_or_null("UI")
	# Ищем UI среди соседних узлов игрока.
	#
	# В твоей текущей сцене Player.tscn это работает,
	# потому что UI находится рядом с KinematicBody
	# внутри корневого Player.


	if ui:
		# Если UI найден,


		var hp_bar = ui.get_node_or_null("HPBar")
		# Ищем внутри UI узел HPBar.


		if hp_bar:
			# Если HPBar найден,


			hp_bar.max_value = max_hp
			# Устанавливаем максимум полоски.


			hp_bar.value = current_hp
			# Устанавливаем текущее значение полоски.


# ============================================================
# ПАУЗА
# ============================================================

func pause_game():
	# Включает состояние паузы.


	is_paused = true
	# Запоминаем, что игрок находится на паузе.


	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	# Освобождаем мышь, чтобы её можно было использовать в меню.


	print("Пауза")


func resume_game():
	# Выключает состояние паузы.


	is_paused = false
	# Возвращаем обычное состояние игры.


	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	# Снова захватываем мышь игрой.


	print("Продолжить")
